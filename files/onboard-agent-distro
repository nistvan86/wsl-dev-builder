#!/usr/bin/env bash
set -Eeuo pipefail

fail() { printf '[onboard] ERROR: %s\n' "$*" >&2; exit 1; }
if [[ "$(id -u)" != 1000 ]]; then
  exec runuser -u ubuntu -- env HOME=/home/ubuntu bash /usr/local/bin/onboard-agent-distro "$@"
fi
[[ "$(id -un)" == ubuntu ]] || fail 'must run as the default ubuntu user'
printf '[onboard] re-run with: /usr/local/bin/onboard-agent-distro\n'

init_directory=/usr/local/lib/wsl-dev-builder/onboard-init.d
if [[ -d "$init_directory" ]]; then
  shopt -s nullglob
  initializers=("$init_directory"/*.sh)
  for initializer in "${initializers[@]}"; do
    # shellcheck source=/dev/null
    . "$initializer"
  done
fi

onboard_directory=/usr/local/lib/wsl-dev-builder/onboard.d
if [[ ! -d "$onboard_directory" ]]; then
  printf '[onboard] no onboarding scripts are installed\n'
  exit 0
fi

reset_tty() {
  if [[ -c /dev/tty ]]; then stty sane </dev/tty >/dev/null 2>&1 || true; fi
}

shopt -s nullglob
contributors=("$onboard_directory"/*.sh)
if (( ${#contributors[@]} == 0 )); then
  printf '[onboard] no onboarding scripts are installed\n'
else
  for contributor in "${contributors[@]}"; do
    reset_tty
    contributor_name=$(basename "$contributor" .sh)
    answer=''
    if [[ -r /dev/tty && -w /dev/tty ]]; then
      if ! IFS= read -r -p "[onboard] Run $contributor_name onboarding? (y/N) " answer < /dev/tty; then answer=''; fi
    fi
    case "$answer" in
      y|Y|yes|YES|Yes)
        bash "$contributor"
        reset_tty
        ;;
      *)
        printf '[onboard] skipped %s onboarding\n' "$contributor_name"
        ;;
    esac
  done
fi

printf '[onboard] completed for %s\n' "${WSL_DISTRO_NAME:-this distro}"
