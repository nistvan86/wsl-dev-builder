#!/usr/bin/env bash
set -Eeuo pipefail

fail() { printf '[onboard] ERROR: %s\n' "$*" >&2; exit 1; }
[[ "$(id -u)" == 1000 && "$(id -un)" == ubuntu ]] || fail 'must run as the default ubuntu user'

# Onboarding runs directly from WSL, so establish the user-local and nvm paths
# required by module contributors without relying on an inherited shell profile.
export PATH="/home/ubuntu/.local/bin:$PATH"
for node_bin in /home/ubuntu/.nvm/versions/node/*/bin; do
  if [[ -x "$node_bin/node" ]]; then
    export PATH="$node_bin:$PATH"
    break
  fi
done

onboard_directory=/usr/local/lib/wsl-dev-builder/onboard.d
[[ -d "$onboard_directory" ]] || fail 'onboarding contributions are missing'

shopt -s nullglob
contributors=("$onboard_directory"/*.sh)
if (( ${#contributors[@]} == 0 )); then
  printf '[onboard] no selected packages require onboarding\n'
else
  for contributor in "${contributors[@]}"; do
    bash "$contributor"
  done
fi

printf '[onboard] completed for %s\n' "${WSL_DISTRO_NAME:-this distro}"
